{
  "name": "@elparko/cuvette",
  "version": "0.1.0",
  "description": "A terminal agent that analyzes data in existing science software while the scientist owns the method decisions.",
  "license": "AGPL-3.0-only",
  "homepage": "https://cuvette.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elparko/cuvette.git"
  },
  "type": "module",
  "bin": {
    "cuvette": "bin/cuvette.js"
  },
  "files": [
    "bin/",
    "!bin/ga.js",
    "src/",
    "!src/ui-web/",
    "ui-dist/",
    "catalog/",
    "samples/",
    "scripts/build-registry-index.mjs",
    "registry-template/",
    "README.md",
    "!**/__pycache__/",
    "!**/*.pyc"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cuvette": "tsx src/cli.ts",
    "test": "vitest run",
    "test:live": "CUVETTE_LIVE=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint:text": "tsx src/lint-text.ts",
    "ui:build": "vite build --config src/ui-web/vite.config.ts",
    "ui:dev": "vite --config src/ui-web/vite.config.ts",
    "prepack": "npm run ui:build",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "desktop:dev": "node desktop/scripts/build.mjs dev",
    "desktop:build": "node desktop/scripts/build.mjs build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
