{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cuvette",
  "version": "0.1.1",
  "identifier": "com.elparko.cuvette",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.education",
    "copyright": "Parker Smith",
    "shortDescription": "Guided analysis of science data with your own programs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["../build/bin/node"],
    "resources": {
      "../build/core/": "core/",
      "cli-tool.sh": "cli-tool.sh"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
